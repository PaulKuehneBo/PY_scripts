    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Aktuelle Datei",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: devl Benzol",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/devl/molecular/molecular_benzene.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Molecular-Soup",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/devl/molecular/molecular_soup.py",
            "args": [ "--ethanol", "2",
                      "--dimethyl_ether", "1", 
                      "--acetone", "3", 
                      "--nucleus-repulsion-factor", "5",
                      "--nucleus-repulsion-radius", "5", 
                      "--stop-at-start" ],
            "console": "integratedTerminal"
        },
        {
            "name": "Python: devl cyclic",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/devl/molecular/molecular_cyclic.py",
            "args": [ "--ring", "benzol", "--C1", "hydroxyl", "--C3", "amino" ],
            "console": "integratedTerminal"
        },
        {
            "name": "Python: devl Salzkristall",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/devl/molecular/molecular_na_cl.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: devl Moleküle H2O",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/devl/molecular/molecular_h2o.py",
            "args": ["--lake-size", "10", 
                     "--nucleus-repulsion-factor", "10",
                     "--nucleus-repulsion-radius", "3"],
            "console": "integratedTerminal"
        },
        {
            "name": "Python: devl Moleküle H, OH",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/devl/molecular/molecular_oh_proton.py",
            "console": "integratedTerminal"
        }
    ]
}