{
    "files.autoSave": "onFocusChange",
    "python.formatting.autopep8Args": ["--max-line-length", "120", "--experimental"],
    "[python]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true
    },
    "workbench.tree.indent": 18,
