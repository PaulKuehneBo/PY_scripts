# Ignore everything unless explicitly allowed below.
*

# Allow the Git ignore file and these directories, including their contents.
!.gitignore
!pyproject.toml
!src/
!src/**
!devl/
!devl/**

# Re-ignore CPython directories, even inside allowed folders.
**/__pycache__/
**/*.pyc
**/*.pyd
**/build/
**/dist/